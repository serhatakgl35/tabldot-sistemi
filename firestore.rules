rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function me() {
      return get(userPath()).data;
    }

    function approved() {
      return hasProfile() && me().approved == true && me().rejected != true;
    }

    function hasRole(role) {
      return approved() && (me().get('role', 'staff') == role || me().get('roles', []).hasAny([role]));
    }

    function hasExtra(permission) {
      return approved() && me().get('extraPermissions', []).hasAny([permission]);
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function canPersonnelView() {
      return isAdmin() || hasRole('administrative') || hasRole('commander') || hasExtra('personnel.view');
    }

    function canAttendanceView() {
      return isAdmin() || hasRole('administrative') || hasRole('commander') || hasExtra('attendance.view');
    }

    function canAttendanceManage() {
      return isAdmin() || hasRole('administrative') || hasExtra('attendance.manage');
    }

    function canLeaveView() {
      return isAdmin() || hasRole('administrative') || hasRole('commander') || hasExtra('leave.view');
    }

    function canLeaveManage() {
      return isAdmin() || hasRole('administrative') || hasExtra('leave.manage');
    }

    function canLeaveApprove() {
      return isAdmin() || hasRole('commander') || hasExtra('leave.approve');
    }

    function canLeavePlan() {
      return isAdmin() || hasRole('commander') || hasExtra('leave.plan');
    }

    function canMealManage() {
      return isAdmin() || hasRole('tabldot') || hasRole('administrative') || hasExtra('meal.manage');
    }

    function canFinanceManage() {
      return isAdmin() || hasRole('tabldot') || hasRole('administrative') || hasExtra('finance.manage');
    }

    function canKitchenView() {
      return isAdmin() || hasRole('cook') || hasExtra('kitchen.view');
    }

    function canLaundryManage() {
      return isAdmin() || hasExtra('laundry.manage');
    }

    function needsDirectory() {
      return canPersonnelView() || canAttendanceView() || canAttendanceManage() ||
             canLeaveView() || canLeaveManage() || canLeaveApprove() || canLeavePlan() ||
             canMealManage() || canFinanceManage() || canKitchenView();
    }

    function ownNumericId(value) {
      return approved() && value == me().id;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || (approved() && needsDirectory()));
      allow list: if approved() && needsDirectory();

      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'staff' &&
        request.resource.data.roles == ['staff'] &&
        request.resource.data.extraPermissions.size() == 0 &&
        request.resource.data.approved == false &&
        request.resource.data.rejected == false &&
        request.resource.data.annualAllowance == 30 &&
        request.resource.data.roadAllowance == 2 &&
        request.resource.data.usedLeave == 0 &&
        request.resource.data.usedRoadLeave == 0 &&
        request.resource.data.planningScore == 50 &&
        request.resource.data.keys().hasOnly([
          'id','uid','name','phone','title','role','roles','extraPermissions','approved','rejected',
          'annualAllowance','roadAllowance','usedLeave','usedRoadLeave','planningScore','planningScoreNote',
          'createdAt','updatedAt'
        ])
      );

      allow update: if isAdmin() ||
        (approved() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','title'])) ||
        (canLeaveManage() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','title','annualAllowance','roadAllowance','usedLeave','usedRoadLeave'
          ])) ||
        (canLeavePlan() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planningScore','planningScoreNote']));

      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if approved();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (canFinanceManage() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bankName','accountName','iban','balancePeriod'
        ])) ||
        (canLaundryManage() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'laundryMachineStatus'
        ]));
      allow delete: if false;
    }

    match /mealChoices/{docId} {
      allow read: if approved() && (
        ownNumericId(resource.data.userId) || canKitchenView() || canMealManage() || canFinanceManage()
      );
      allow create: if approved() && ownNumericId(request.resource.data.userId);
      allow update, delete: if approved() && ownNumericId(resource.data.userId);
    }

    match /mealExpenses/{docId} {
      allow read, create, update, delete: if canFinanceManage();
    }

    match /payments/{docId} {
      allow read: if approved() && (ownNumericId(resource.data.userId) || canFinanceManage());
      allow create: if approved() && (
        canFinanceManage() ||
        (ownNumericId(request.resource.data.userId) && request.resource.data.status == 'pending')
      );
      allow update, delete: if canFinanceManage();
    }

    match /debts/{docId} {
      allow read: if approved() && (ownNumericId(resource.data.userId) || canFinanceManage());
      allow create, update, delete: if canFinanceManage();
    }

    match /leaveRequests/{docId} {
      allow read: if approved() && (
        ownNumericId(resource.data.userId) ||
        canLeaveView() || canLeaveManage() || canLeaveApprove() || canLeavePlan() ||
        canAttendanceView() || canAttendanceManage() ||
        ((canKitchenView() || canMealManage() || canFinanceManage()) &&
          resource.data.type == 'Yıllık İzin' && resource.data.status == 'approved')
      );

      allow create: if approved() && (
        (ownNumericId(request.resource.data.userId) && request.resource.data.status == 'pending') ||
        canLeaveManage()
      );

      allow update: if approved() && (
        (ownNumericId(resource.data.userId) && resource.data.status != 'approved' &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status) ||
        canLeaveManage() ||
        (canLeaveApprove() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','approvedAt','approvedBy','reviewedAt','reviewedBy'
        ]))
      );

      allow delete: if approved() && (
        canLeaveManage() || (ownNumericId(resource.data.userId) && resource.data.status != 'approved')
      );
    }

    match /leavePreferences/{docId} {
      allow read: if approved() && (ownNumericId(resource.data.userId) || canLeaveView() || canLeavePlan());
      allow create: if approved() && (ownNumericId(request.resource.data.userId) || canLeavePlan());
      allow update, delete: if approved() && (ownNumericId(resource.data.userId) || canLeavePlan());
    }

    match /leavePlanResults/{docId} {
      allow read: if approved() && (ownNumericId(resource.data.userId) || canLeaveView() || canLeavePlan());
      allow create, update: if canLeavePlan();
      allow delete: if canLeavePlan() || (approved() && ownNumericId(resource.data.userId));
    }

    match /attendance/{docId} {
      allow read: if approved() && (ownNumericId(resource.data.userId) || canAttendanceView() || canAttendanceManage());
      allow create, update, delete: if canAttendanceManage();
    }

    match /laundryReservations/{docId} {
      allow read: if approved();
      allow create: if approved() && (ownNumericId(request.resource.data.userId) || canLaundryManage());
      allow update: if canLaundryManage();
      allow delete: if approved() && (ownNumericId(resource.data.userId) || canLaundryManage());
    }

    match /laundryFaults/{docId} {
      allow read: if approved();
      allow create: if approved() && ownNumericId(request.resource.data.userId) && request.resource.data.status == 'Açık';
      allow update, delete: if canLaundryManage();
    }

    match /auditLogs/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if approved() && request.resource.data.userId == me().id;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
